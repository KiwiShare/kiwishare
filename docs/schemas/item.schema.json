{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ItemModel",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique listing identifier (UUID)."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Descriptive title of the item."
    },
    "priceNzd": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{2})?$",
      "description": "Price of the item in New Zealand Dollars."
    },
    "location": {
      "type": "string",
      "description": "Sub-region location coordinates or city name."
    },
    "imageUrl": {
      "type": "string",
      "format": "uri",
      "description": "Public link to listing image."
    },
    "isSustainable": {
      "type": "boolean",
      "description": "Flags whether the item contributes to sustainability goals."
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Marketplace category value exposed by the discovery-options endpoint."
    },
    "latitude": {
      "type": ["number", "null"],
      "minimum": -90,
      "maximum": 90,
      "description": "Approximate listing latitude when supplied."
    },
    "longitude": {
      "type": ["number", "null"],
      "minimum": -180,
      "maximum": 180,
      "description": "Approximate listing longitude when supplied."
    },
    "status": {
      "type": "string",
      "enum": ["active", "reserved", "sold"],
      "description": "Transaction state of the item listing."
    },
    "ownerId": {
      "type": "string",
      "description": "UID of the user listing the item."
    }
  },
  "required": [
    "id",
    "title",
    "priceNzd",
    "location",
    "imageUrl",
    "isSustainable",
    "category",
    "status",
    "ownerId"
  ]
}
