{
  "name": "kiwishare-monorepo",
  "private": true,
  "description": "Monorepo for KiwiShare - Mobile App (Flutter) and Backend Cloud Functions (Koa + TypeScript)",
  "scripts": {
    "prepare": "husky install",
    "bootstrap": "pnpm install --ignore-scripts && cd mobile && flutter pub get",
    "mobile:test": "cd mobile && flutter test",
    "mobile:analyze": "cd mobile && flutter analyze",
    "mobile:format": "cd mobile && dart format --set-exit-if-changed lib/ test/",
    "functions:build": "pnpm --filter functions run build",
    "functions:test": "pnpm --filter functions run test",
    "functions:lint": "pnpm --filter functions run lint",
    "functions:dev": "pnpm --filter functions run dev",
    "mobile:dev": "cd mobile && flutter run",
    "dev": "concurrently \"pnpm functions:dev\" \"pnpm mobile:dev\"",
    "test:all": "pnpm run mobile:test && pnpm run functions:test",
    "lint:all": "pnpm run mobile:analyze && pnpm run functions:lint",
    "format:all": "pnpm run mobile:format",
    "emulators": "firebase emulators:start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UOA-CS734-S2-2026/project-implementation-five-guys.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UOA-CS734-S2-2026/project-implementation-five-guys/issues"
  },
  "homepage": "https://github.com/UOA-CS734-S2-2026/project-implementation-five-guys#readme",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "protobufjs"
    ]
  }
}
