# Required: random JWT signing secret, at least 32 characters. Generate and
# store it in the deployment secret manager; never commit the real value.
# The server refuses to start when this is blank, short, or a known placeholder.
JWT_SECRET=

# Node Environment
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGODB_URI=
MONGODB_URI_TEST=

# Resend Email Configuration (Optional, for OTP and report confirmation delivery)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=KiwiShare <no-reply@yourdomain.co.nz>
# Cloudflare R2 Storage Configuration (S3 Compatible)
R2_ACCOUNT_ID=xxx
R2_BUCKET=kiwishare
R2_ENDPOINT=
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_PUBLIC_URL=https://assets.kiwishare.online

# Optional comma-separated additions to the server's built-in chat moderation list
CHAT_BLOCKED_TERMS=

# Firebase Admin credentials for FCM push delivery. Prefer a secret file via
# GOOGLE_APPLICATION_CREDENTIALS; Render may use a single-line JSON secret.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Comma-separated OAuth client IDs accepted by /api/auth/google (web, iOS, Android).
# These IDs are public identifiers, not secrets.
GOOGLE_OAUTH_CLIENT_IDS=

# Optional server-only Gemini API configuration for authenticated listing
# suggestions. Never expose this key through Flutter build variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

STRIPE_PAYMENT_API_KEY=
# Outbound email safety kill switch. Set true to suppress all real email delivery
# without disabling the business event that would normally trigger it.
DISABLE_OUTBOUND_EMAIL=false
