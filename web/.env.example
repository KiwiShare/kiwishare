# KiwiShare Web Environment Configuration
# Production API target. The web SPA itself is hosted on Cloudflare Workers.
VITE_API_URL=http://localhost:3000

# Firebase Web App config for project kiwishare-2791f.
# These values identify the public Firebase web app; they are not server secrets.
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME
VITE_FIREBASE_PROJECT_ID=REPLACE_ME
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_ME
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME
VITE_FIREBASE_MEASUREMENT_ID=REPLACE_ME

# Store destinations used by the shared-link landing page.
# Replace the defaults with the final KiwiShare store listing URLs once published.
VITE_IOS_APP_URL=https://apps.apple.com/nz/search?term=KiwiShare
VITE_ANDROID_APP_URL=https://play.google.com/store/search?q=KiwiShare&c=apps
